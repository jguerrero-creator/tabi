# Client-side (exposed in the browser bundle — VITE_ prefix required).
# Only ever put values here that are safe to ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Maps JavaScript API key, restricted by HTTP referrer in Google Cloud
# Console to this app's domain(s). This is a display-only key with no
# server-side privileges — distinct from GOOGLE_MAPS_API_KEY below, which
# stays server-only and is used for Directions/Geocoding/Places calls.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side only (used exclusively by functions in /api — never VITE_
# prefixed, never imported from src/). Configure the real values in Vercel
# project settings, not in a committed file.
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=

# Internal Notion integration token (Settings > Connections), shared with the
# "Bugs" data source. Used only by /api/report-bug.ts (TABI-171).
NOTION_API_KEY=
