# Client-side (exposed in the browser bundle — VITE_ prefix required).
# Only ever put values here that are safe to ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Maps JavaScript API key, restricted by HTTP referrer in Google Cloud
# Console to this app's domain(s). This is a display-only key with no
# server-side privileges — distinct from GOOGLE_MAPS_API_KEY below, which
# stays server-only and is used for Directions/Geocoding/Places calls.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side only (used exclusively by functions in /api — never VITE_
# prefixed, never imported from src/). Configure the real values in Vercel
# project settings, not in a committed file.
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
# Verified Resend sender address (or Resend's shared onboarding domain while
# testing, before a custom domain is verified). Used by /api/send-daily-recap.ts.
RESEND_FROM_EMAIL=

# Internal Notion integration token (Settings > Connections), shared with the
# "Bugs" data source. Used only by /api/report-bug.ts (TABI-171).
NOTION_API_KEY=

# Service-role Supabase key (Project Settings > API) — bypasses RLS. Only for
# /api/send-daily-recap.ts, which runs on a schedule with no logged-in user to
# scope a request to. Never forward this to a client, never reuse it for a
# request that has a real user token available (use the anon-key + forwarded
# Authorization pattern in api/_lib/entitlements.ts for those).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# invoking a scheduled function — set this in Vercel and /api/send-daily-recap.ts
# rejects any request that doesn't present it, so the endpoint can't be
# triggered by anyone who finds the URL.
CRON_SECRET=

# Dev-only override (TABI-36): Tabi has no email-capture flow yet (auth is
# anonymous-only), so /api/send-daily-recap.ts has nobody to send a real
# recap to. Setting this to your own address lets you verify the Resend
# integration actually delivers mail end-to-end. Leave unset in production
# until real email capture ships — see api/_lib/recapRecipient.ts.
RECAP_TEST_RECIPIENT=
